      "title": "Live streams",
      "description": "Streams with a connected publisher.",
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(restreamer_ingest_active == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
