          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(restreamer_ingest_active, stream)",
          "refId": "streams"
        },
        "definition": "label_values(restreamer_ingest_active, stream)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "sort": 1
      }
    ]
  },
  "annotations": {
    "list": []
