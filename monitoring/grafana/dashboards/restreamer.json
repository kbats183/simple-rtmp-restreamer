          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (stream, kind) (rate(restreamer_ingest_bytes_total{stream=~\"$stream\"}[$__rate_interval])) * 8",
          "legendFormat": "{{stream}} {{kind}}",
          "refId": "A",
          "range": true,
          "instant": false
