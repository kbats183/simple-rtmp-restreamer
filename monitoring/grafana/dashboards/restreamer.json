            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(restreamer_push_connected == 0 and on (stream) restreamer_ingest_active == 1) or vector(0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
